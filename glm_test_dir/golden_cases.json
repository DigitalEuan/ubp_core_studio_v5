{
  "_meta": {
    "description": "Gold-set benchmark for GLM consolidation. Stable set of cases used for before/after comparison.",
    "version": "1.0",
    "created": "2026-07-01",
    "convention": "Each case has: id, suite, query, expected, match (substring|exact|regex), category (optional), difficulty (optional).",
    "suites": ["mathnet", "mathnet_expanded", "critpt", "language", "failure"],
    "sources": {
      "mathnet": "core/ubp_mathnet_problem_set.json (20 problems)",
      "mathnet_expanded": "core/ubp_mathnet_expanded_problems.json (60 problems)",
      "critpt": "core/critpt.json (frontier physics)",
      "language": "hand-curated language/semantic edge cases",
      "failure": "failure-mode tests for unknown/ambiguous terms"
    },
    "usage": "Run: python benchmarks/run_benchmark.py --suite all --tag baseline"
  },
  "cases": [
